<Project Sdk="Microsoft.NET.Sdk">
  <!-- Machine-specific settings go in local.props (git-ignored), e.g.:
       <Project><PropertyGroup><WotRDir>D:\Games\Pathfinder Second Adventure</WotRDir></PropertyGroup></Project>
       Alternatively set the WOTR_DIR environment variable, or pass -p:WotRDir=... on the command line. -->
  <Import Project="local.props" Condition="Exists('local.props')" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>WotRUpscaler</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- Release builds must not embed the build machine's folder path (the debug-symbol path would put the user name in the DLL). -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <WotRDir Condition="'$(WotRDir)' == '' And '$(WOTR_DIR)' != ''">$(WOTR_DIR)</WotRDir>
    <WotRDir Condition="'$(WotRDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Pathfinder Second Adventure</WotRDir>
    <Managed>$(WotRDir)\Wrath_Data\Managed</Managed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(Managed)\UnityEngine*.dll"><Private>false</Private></Reference>
    <Reference Include="$(Managed)\Unity.RenderPipelines.Core.Runtime.dll"><Private>false</Private></Reference>
    <Reference Include="$(Managed)\Owlcat.Runtime.Visual.dll"><Private>false</Private></Reference>
    <Reference Include="$(Managed)\Owlcat.Runtime.Core.dll"><Private>false</Private></Reference>
    <Reference Include="$(Managed)\Unity.Mathematics.dll"><Private>false</Private></Reference>
    <Reference Include="$(Managed)\UnityModManager\UnityModManager.dll"><Private>false</Private></Reference>
    <Reference Include="$(Managed)\0Harmony.dll"><Private>false</Private></Reference>
    <Reference Include="$(Managed)\Assembly-CSharp.dll"><Private>false</Private></Reference>
  </ItemGroup>
  <!-- Optional: the in-game Mods menu page of the ModMenu mod. Built in when ModMenu is installed next to the game; the mod runs without it. -->
  <PropertyGroup Condition="Exists('$(WotRDir)\Mods\ModMenu\ModMenu.dll')">
    <DefineConstants>$(DefineConstants);MODMENU</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(WotRDir)\Mods\ModMenu\ModMenu.dll')">
    <Reference Include="$(WotRDir)\Mods\ModMenu\ModMenu.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
